POSTGRES_DB=nexus_api
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Generate three different 32-byte Base64 values. Never reuse or commit production keys.
NEXUS_FIELD_ENCRYPTION_KEY=
NEXUS_LOOKUP_HMAC_KEY=
NEXUS_API_KEY_HMAC_KEY_V1=
# 系统访问令牌专用 32 字节 Base64 HMAC 密钥，必须与 API 令牌密钥不同。
NEXUS_SYSTEM_ACCESS_TOKEN_HMAC_KEY_V1=
# 仅供后端读取上游可见服务分组，禁止提交真实值或传给前端。
NEXUS_PRICE_GROUP_SYNC_TOKEN=
NEXUS_ALLOWED_ORIGINS=http://localhost:3000
# Wave 7A 健康探测与同一分组重复告警冷却时间。
HEALTH_PROBE_ENABLED=true
HEALTH_PROBE_INTERVAL=60s
HEALTH_PROBE_TIMEOUT=5s
HEALTH_FAILURE_THRESHOLD=3
HEALTH_CIRCUIT_OPEN_DURATION=5m
HEALTH_ALERT_COOLDOWN=30m
# 支付宝正式支付配置；密钥只允许通过部署环境注入，禁止提交真实值。
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
